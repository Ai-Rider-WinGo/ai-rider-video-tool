{
  "name": "ai-rider-desktop-client",
  "version": "2.3.1",
  "private": true,
  "description": "AI-Rider first/last-frame video generation desktop tool.",
  "main": "desktop/main.js",
  "scripts": {
    "setup:desktop": "ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ npm install",
    "check:env": "node scripts/check-env.js",
    "start:web": "node server.js",
    "license:admin": "node scripts/license-admin.js",
    "start:desktop": "electron .",
    "desktop": "npm run start:desktop",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win nsis",
    "build:desktop": "electron-builder --mac --win nsis",
    "postinstall": "npm run check:env"
  },
  "build": {
    "appId": "com.ai-rider.desktop-client",
    "productName": "AI-Rider｜首尾帧生成视频工具",
    "icon": "desktop/icon.icns",
    "files": [
      "desktop/**/*",
      "lib/**/*",
      "public/**/*",
      "server.js",
      "settings.example.json",
      "README.md",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.video",
      "icon": "desktop/icon.icns"
    },
    "win": {
      "icon": "desktop/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-${version}-setup-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^41.2.2",
    "electron-builder": "^26.0.0"
  }
}
